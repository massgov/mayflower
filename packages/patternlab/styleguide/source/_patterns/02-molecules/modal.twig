<button type="button" class="ma__utility-nav__link" data-modal-trigger="ma__modal" aria-haspopup="dialog" aria-controls="ma__modal">
    {% if modal.buttonIcon %}
        {{ icon(modal.buttonIcon, "20", "20") }}
    {% endif %}
    <span>{{ modal.buttonText }}</span>
</button>
<div id="ma__modal" class="ma__modal-overlay" role="dialog" aria-modal="true" aria-labelledby="ma__modal-title">
    <div class="ma__modal-dialog">
        <div class="ma__modal-header">
            <h2 id="ma__modal-title" class="ma__modal-title">{{ modal.title }}</h2>
            <button type="button" class="ma__modal-close" aria-label="Close dialog">
                {{ icon("close", "24", "24") }}
            </button>
        </div>
        <div class="ma__modal-content">
            {% block htmlContent %}
                {% if googleLanguages %}
                    {% include "@molecules/google-translate.twig" with {
                        "googleLanguages": googleLanguages
                    } %}
                {% endif %}
            {% endblock %}
        </div>
    </div>
</div>

