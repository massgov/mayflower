{% set stateBannerPanelId = stateBanner.panelId|default('mds-state-banner-panel') %}

<section class="mds-state-banner mds-padding-block-3xs mds-background-static-black mds-text-and-icons-static-white mds-section-container" aria-label="{{ stateBanner.ariaLabel|default('Official website banner') }}" data-node-id="{{ stateBanner.nodeId|default('1:929') }}">
  <div class="mds-state-banner__container">
    <details class="mds-state-banner__details">
      <summary class="mds-state-banner__summary">
        <span class="mds-state-banner__inner">
          <span class="mds-state-banner__brand">
            <img
              class="mds-state-banner__seal"
              src="{{ stateBanner.seal.src|default('https://unpkg.com/@massds/mds-assets@1.0.1/dist/state-seal/state-seal-white.svg') }}"
              alt="{{ stateBanner.seal.alt|default('Massachusetts State Seal') }}"
            >
            <span class="mds-state-banner__title ">{{ stateBanner.title|default('An official website of the Commonwealth of Massachusetts') }}</span>
          </span>
          <span
            class="mds-state-banner__toggle-text mds-border-brand-neutral-mid"
          >
            <span>{{ stateBanner.toggleText|default("Here's how you know") }}</span>
            <svg class="mds-state-banner__caret" aria-hidden="true" viewBox="0 0 20 20" focusable="false">
              <path d="M6 8L10 12L14 8"></path>
            </svg>
          </span>
        </span>
      </summary>
      <div class="mds-state-banner__panel" id="{{ stateBannerPanelId }}">
        <ul class="mds-state-banner__items" role="region">
          <li class="mds-state-banner__item mds-padding-block-start-2xs">
            <svg class="mds-state-banner__item-icon mds-text-and-icons-static-white " aria-hidden="true" viewBox="0 0 24 24" focusable="false" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.561 10.804a.645.645 0 0 1-.644-.645 4.804 4.804 0 0 0-4.799-4.798 4.804 4.804 0 0 0-4.798 4.798.645.645 0 1 1-1.29 0 6.094 6.094 0 0 1 6.088-6.088 6.094 6.094 0 0 1 6.088 6.088.645.645 0 0 1-.645.644m4.018 2.343H2.395a.645.645 0 1 1 0-1.29h19.184a.645.645 0 0 1 0 1.29m.027 8.93h-19.2a.645.645 0 0 1-.644-.644V17.73c0-.356.289-.645.645-.645h19.195c.356 0 .645.29.645.645l.003 3.702a.645.645 0 0 1-.644.646M3.052 20.789H20.96l-.002-2.413H3.052z"/><path d="M12.119 5.36a.645.645 0 0 1-.645-.644v-2.15a.645.645 0 1 1 1.29 0v2.15a.645.645 0 0 1-.646.645m6.699 7.043a.645.645 0 0 1-.645-.645v-.936H6.023v.936a.645.645 0 1 1-1.29 0v-1.58c0-.357.29-.646.646-.646h13.439c.356 0 .645.289.645.645v1.58a.645.645 0 0 1-.645.646m-15.715 5.76a.645.645 0 0 1-.645-.645v-4.898a.645.645 0 1 1 1.29 0v4.898a.645.645 0 0 1-.645.645m17.864 0a.645.645 0 0 1-.645-.645v-4.898a.645.645 0 1 1 1.29 0v4.898a.645.645 0 0 1-.645.645"/><path d="M7.57 18.164a.645.645 0 0 1-.645-.645v-4.898a.645.645 0 1 1 1.29 0v4.898a.645.645 0 0 1-.646.645m4.466 0a.645.645 0 0 1-.645-.645v-4.898a.645.645 0 1 1 1.29 0v4.898a.645.645 0 0 1-.645.645m4.466 0a.645.645 0 0 1-.645-.645v-4.898a.645.645 0 1 1 1.29 0v4.898a.645.645 0 0 1-.645.645"/>
            </svg>
            <div class="mds-state-banner__item-copy mds-padding-block-start-3xs">
              <h2 class="mds-text-label">{{ stateBanner.massGovTitle|default('Official websites use .mass.gov') }}</h2>
              <p class="mds-padding-block-start-2xs">{{ stateBanner.massGovDescription|default('A .mass.gov website belongs to an official government organization in Massachusetts.') }}</p>
            </div>
          </li>

          <li class="mds-state-banner__item mds-padding-block-start-2xs">
            <svg class="mds-state-banner__item-icon mds-text-and-icons-static-white " aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path d="M19.5 7.5h-3V5.25a4.5 4.5 0 1 0-9 0V7.5h-3A1.5 1.5 0 0 0 3 9v10.5A1.5 1.5 0 0 0 4.5 21h15a1.5 1.5 0 0 0 1.5-1.5V9a1.5 1.5 0 0 0-1.5-1.5M9 5.25a3 3 0 1 1 6 0V7.5H9zM19.5 19.5h-15V9h15z"/>
            </svg>
            <div class="mds-state-banner__item-copy mds-padding-block-start-3xs">
              <h2 class="mds-text-label">{{ stateBanner.httpsTitle|default('Secure websites use HTTPS certificate') }}</h2>
              <p class="mds-text-body mds-padding-block-start-2xs">{{ stateBanner.httpsDescription|default("A lock icon or https:// means you've safely connected to the official website. Share sensitive information only on official, secure websites.") }}</p>
            </div>
          </li>
        </ul>
      </div>
    </details>
  </div>
</section>
