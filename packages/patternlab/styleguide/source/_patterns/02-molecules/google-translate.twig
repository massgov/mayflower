<!-- Status message for screen readers -->
<div id="ma__translate-status" class="ma__status-message" role="status" aria-live="polite" aria-atomic="true"></div>

<!-- Accessible language selector -->
<div class="ma__translate-container">
  <legend class="ma__translate-legend"><span>{{ icon("translate", "28", "28") }}</span></legend>

  <label id="ma__translate-label" class="ma__translate-label" for="ma__translate-select">
    Select language
  </label>

  <div class="ma__translate-select-wrapper">
    <select
        id="ma__translate-select"
        class="ma__translate-select"
        aria-describedby="ma__translate-help"
    >
      {% block languageOptions %}
        <option value="en">English</option>
        <option value="af">Afrikaans</option>
        <option value="sq">Shqip</option>
        <option value="am">አማርኛ</option>
        <option value="ar">العربية</option>
        <option value="hy">Հայերեն</option>
        <option value="zh-CN">简体中文</option>
        <option value="zh-TW">繁體中文</option>
        <option value="tl">Filipino</option>
        <option value="fr">Français</option>
        <option value="de">Deutsch</option>
        <option value="el">Ελληνικά</option>
        <option value="gu">ગુજરાતી</option>
        <option value="ht">Kreyòl Ayisyen</option>
        <option value="iw">עברית</option>
        <option value="hi">हिन्दी</option>
        <option value="hmn">Hmoob</option>
        <option value="it">Italiano</option>
        <option value="ja">日本語</option>
        <option value="km">ភាសាខ្មែរ</option>
        <option value="rw">Kinyarwanda</option>
        <option value="ko">한국어</option>
        <option value="lo">ລາວ</option>
        <option value="ml">മലയാളം</option>
        <option value="my">မြန်မာ</option>
        <option value="ne">नेपाली</option>
        <option value="ps">پښتو</option>
        <option value="fa">فارسی</option>
        <option value="pl">Polski</option>
        <option value="pt">Português</option>
        <option value="ro">Română</option>
        <option value="ru">Русский</option>
        <option value="so">Soomaali</option>
        <option value="es">Español</option>
        <option value="sw">Kiswahili</option>
        <option value="ta">தமிழ்</option>
        <option value="te">తెలుగు</option>
        <option value="th">ไทย</option>
        <option value="ti">ትግርኛ</option>
        <option value="tr">Türkçe</option>
        <option value="uk">Українська</option>
        <option value="ur">اردو</option>
        <option value="vi">Tiếng Việt</option>
      {% endblock %}
    </select>

    <span class="ma__translate-select-caret-down">
      {{ icon("caret-down", "20", "20") }}
    </span>
  </div>

  <div id="ma__translate-help">
    <span class="ma__sr-only">
      Select a language from the dropdown menu and press the Apply button to translate the page
    </span>
    <p>Disclaimer: This feature uses the Google Translate Widget. Due to the limitation of machine translation, some pages or content may not be translated accurately.</p>
  </div>

  <div class="ma__button-group">
    <button
        id="ma__translate-apply"
        class="ma__translate-button"
        type="button"
    >
      Translate
    </button>

    <button
        id="ma__translate-reset"
        class="ma__translate-button ma__translate-reset-button"
        type="button"
        lang="en"
        style="margin-left: 8px;"
    >
      Show original
    </button>
  </div>
</div>

<!-- Hidden Google Translate Element -->
<div class="ma__goog-te-wrapper">
  <div id="google_translate_element"></div>
</div>
