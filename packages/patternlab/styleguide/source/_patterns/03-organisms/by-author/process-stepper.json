{
  "processStepper": {
    "compHeading": {
      "title": "Steps to start your business",
      "level": 2
    },
    "steps": [
      {
        "title": "Check your business name",
        "richText": {
          "rteElements": [
            {
              "path": "@atoms/11-text/paragraph.twig",
              "data": {
                "paragraph": {
                  "text": "To do business in the Commonwealth, you must first check to see if your desired business name is available."
                }
              }
            }
          ]
        },
        "button": {
          "text": "Search for a business entity",
          "href": "#",
          "theme": "c-primary-alt",
          "uppercaseOverride": true
        },
        "downloadLinks": [
          {
            "downloadLink": {
              "iconSize": "small",
              "icon": "file",
              "decorativeLink": {
                "text": "inline link",
                "href": "#"
              },
              "size": "26MB",
              "format": "Filesize",
              "noParentheses": true
            }
          }
        ]
      },
      {
        "title": "File with the Secretary of the Commonwealth",
        "richText": {
          "rteElements": [
            {
              "path": "@molecules/inline-message.twig",
              "data": {
                "inlineMessage": {
                  "type": "info",
                  "heading": "Info Inline Message heading goes here",
                  "richText": {
                    "rteElements": [
                      {
                        "path": "@atoms/11-text/paragraph.twig",
                        "data": {
                          "paragraph": {
                            "text": "Any business filing with the Secretary of the Commonwealth may also have to report information to the federal government. <a href=\"#\">Learn more about filing a beneficial ownership information (BOI) report with FinCEN.</a>"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            {
              "path": "@atoms/11-text/paragraph.twig",
              "data": {
                "paragraph": {
                  "text": "If your business must file with the Secretary of the Commonwealth, visit their Filing by Subject page and follow the steps for the business structure you have chosen."
                }
              }
            }
          ]
        },
        "button": {
          "text": "File with the Secretary of the Commonwealth",
          "href": "#",
          "theme": "c-primary-alt",
          "uppercaseOverride": true
        },
        "downloadLinks": [
          {
            "downloadLink": {
              "iconSize": "small",
              "icon": "file",
              "decorativeLink": {
                "text": "inline link",
                "href": "#"
              },
              "size": "26MB",
              "format": "Filesize",
              "noParentheses": true
            }
          }
        ]
      },
      {
        "title": "Get a local business certificate (DBA)",
        "richText": {
          "rteElements": [
            {
              "path": "@molecules/inline-message.twig",
              "data": {
                "inlineMessage": {
                  "type": "warning",
                  "heading": "Important Note on Certificates",
                  "richText": {
                    "rteElements": [
                      {
                        "path": "@atoms/11-text/paragraph.twig",
                        "data": {
                          "paragraph": {
                            "text": "Make sure to verify if your city or town requires additional local permits alongside your business certificate. <a href=\"#\">Check local municipal guidelines.</a>"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            {
              "path": "@atoms/11-text/paragraph.twig",
              "data": {
                "paragraph": {
                  "text": "You file this certificate with the city or town clerk in the city or town where your business is located."
                }
              }
            }
          ]
        },
        "button": {
          "text": "Schedule an in-person appointment",
          "href": "#",
          "theme": "c-primary-alt",
          "uppercaseOverride": true
        },
        "downloadLinks": [
          {
            "downloadLink": {
              "iconSize": "small",
              "icon": "file",
              "decorativeLink": {
                "text": "inline link",
                "href": "#"
              },
              "size": "26MB",
              "format": "Filesize",
              "noParentheses": true
            }
          }
        ]
      }
    ]
  }
}
