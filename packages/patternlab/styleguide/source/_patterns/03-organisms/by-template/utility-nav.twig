<div class="ma__utility-nav js-util-nav">
  <ul class="ma__utility-nav__items">
    {% if googleLanguages %}
      <li class="ma__utility-nav__item">
        <button type="button" class="ma__utility-nav__link" data-modal-trigger="modal-medium" aria-haspopup="dialog" aria-controls="modal-medium">
          {{ icon("translate", "20", "20") }}
          <span>Language</span>
        </button>
        <div id="modal-medium" class="ads-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-medium-title">
          <div class="ads-modal-dialog ads-modal-medium">
            <div class="ads-modal-header">
              <h2 id="modal-medium-title" class="ads-modal-title">Select language</h2>
              <button type="button" class="ads-modal-close" aria-label="Close dialog">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                </svg>
              </button>
            </div>
            <div class="ads-modal-content">
              <div id="google_translate_element"></div>
              <p>Disclaimer: This feature uses the Google Translate Widget. Due to the limitation of machine translation, some pages or content may not be translated accurately.</p>
            </div>
            <div class="ads-modal-footer">
              <button type="button" class="ads-modal-btn-translate">Translate</button>
              <button type="button" class="ads-modal-btn-show-original">Show original</button>
            </div>
          </div>
        </div>
      </li>
    {% endif %}
    {% for item in utilityNav.items %}
      <li class="ma__utility-nav__item">
      {% if item.text == 'State Organizations' %}
        {# Get hef value. #}
        {% for panel in item.panels %}
          {% for link in panel.links %}
            <a class="ma__utility-nav__link direct-link" href="{{ link.href }}">
              {{ icon(item.icon, "20", "18") }}
              <span>{{ item.text }}</span>
            </a>
         {% endfor %}
        {% endfor %}
      {% else %}
        <button
            class="ma__utility-nav__link js-util-nav-toggle"
            id="{{ item.id }}"
            aria-controls="panel-{{ item.id }}"
            aria-haspopup="true"
            aria-label="{% if item.ariaLabelText %}{{ item.ariaLabelText }}{% else %}{{ item.text }}{% endif %}"
            aria-expanded="false">
            {{ icon(item.icon, "20", "20") }}
            <span>
              {{ item.text }}
            </span>
            {# Add toggle icon for hamburger menu item. #}
            <span class="toggle-indicator" aria-hidden="true"></span>
          </button>
          <div
              aria-hidden="true"
              class="ma__utility-nav__content js-util-nav-content is-closed"
              id="panel-{{ item.id }}">
            <div class="ma__utility-nav__container">
              <div class="ma__utility-nav__content-title">
                {{ icon(item.icon) }}
                <div>{{ item.text }}</div>
              </div>
              <div class="ma__utility-nav__content-body">
                {% set utilityPanel = item.panel %}
                {% for item in item.panels %}
                {% include "@organisms/by-template/utility-panel.twig" %}
                {% endfor %}
              </div>
              <button class="ma__utility-nav__close js-close-util-nav">
                <span>{{ item.closeText }}</span>
                <span class="ma__utility-nav__close-icon" aria-hidden="true">+</span>
              </button>
            </div>
          </div>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</div>
